# ================================
# Environment variables template for Docker Compose
# ================================
# 
# INSTRUCTIONS:
# 1. Copy this file as .env
# 2. Modify the values according to your environment
# 3. NEVER commit the .env file to the repository
#

# PostgreSQL Database
POSTGRES_DB=consentidos
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_super_secure_password

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/consentidos
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_super_secure_password

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Active Profile
SPRING_PROFILES_ACTIVE=docker

# Ports (optional - default values are used if not specified)
APP_PORT=8080
DB_PORT=5432
ADMINER_PORT=8081

# ================================
# For production, consider using:
# ================================
# - Docker Secrets
# - System environment variables
# - Secret management services (AWS Secrets Manager, Azure Key Vault, etc.)
# - Tools like HashiCorp Vault